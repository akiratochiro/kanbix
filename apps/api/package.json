{
  "name": "@kanbix/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
"scripts": {
  "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
  "prisma:generate": "dotenv -e ../../.env -- prisma generate",
  "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
  "prisma:studio": "dotenv -e ../../.env -- prisma studio",
  "prisma:migrate:test": "dotenv -e ../../.env.test -- prisma migrate deploy",
  "test": "jest --config jest.config.js",
  "test:integration": "dotenv -e ../../.env.test -- jest --config jest.integration.config.js"
},
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^X.X.X",
    "jest": "^30.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
